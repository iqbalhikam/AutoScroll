    <string name="app_name">AutoScroll</string>
    <string name="service_label">AutoScroll TikTok</string>
    <string name="service_description">Memantau posisi video TikTok lalu menggulir otomatis saat video selesai. Hanya membaca struktur tampilan saat aktif, tidak mengumpulkan data pribadi.</string>

    <string name="tagline">TikTok hands-free</string>
    <string name="hero_subtitle">Deteksi akhir video secara otomatis, lalu geser ke video berikutnya tanpa menyentuh layar.</string>

