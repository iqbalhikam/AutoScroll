<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="26dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_row"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:text="@string/hand_test_back"
            android:textColor="@color/accent"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/hand_test_title"
            android:textColor="@color/textPrimary"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/hand_test_sub"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/tvVerdict"
                style="@style/Section"
                android:text="@string/hand_test_status_off"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvVerdictSub"
                style="@style/Caption"
                android:layout_marginTop="6dp"
                android:text="@string/hand_test_hint" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Section"
                android:text="@string/hand_test_live" />

            <TextView
                android:id="@+id/tvStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/textSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Section"
                android:text="@string/hand_test_reading_title" />

            <TextView
                style="@style/Caption"
                android:layout_marginTop="8dp"
                android:text="@string/hand_test_reading" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_segment_on"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:text="@string/hand_test_start"
            android:textColor="@color/accent"
            android:textSize="14sp" />

        <TextView
            style="@style/Caption"
            android:layout_marginTop="12dp"
            android:text="@string/hand_test_foot"
            android:textColor="@color/textMuted"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
